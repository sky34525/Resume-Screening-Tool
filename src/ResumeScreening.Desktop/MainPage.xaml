<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ResumeScreening_Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ResumeScreening_Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ResumeScreening_Desktop.Models"
    mc:Ignorable="d">

    <NavigationView
        x:Name="ShellNavigation"
        AutomationProperties.AutomationId="ShellNavigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Auto"
        PaneTitle="简历筛选"
        SelectionFollowsFocus="Enabled">
        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="ResumeLibraryItem"
                AutomationProperties.AutomationId="ResumeLibraryNavigationItem"
                AutomationProperties.Name="简历库"
                Content="简历库"
                IsSelected="True"
                Tag="resumes">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8A5;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                AutomationProperties.AutomationId="AiScreeningNavigationItem"
                AutomationProperties.Name="AI 初筛，即将推出"
                Content="AI 初筛（即将推出）"
                IsEnabled="False">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE9D9;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                AutomationProperties.AutomationId="JobManagementNavigationItem"
                AutomationProperties.Name="职位管理，即将推出"
                Content="职位管理（即将推出）"
                IsEnabled="False">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE821;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                AutomationProperties.AutomationId="AnalyticsNavigationItem"
                AutomationProperties.Name="分析报表，即将推出"
                Content="分析报表（即将推出）"
                IsEnabled="False">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE9D2;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid x:Name="ContentRoot" Padding="28,24,28,28" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="候选人简历" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.ResumeCountText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    AutomationProperties.AutomationId="ImportResumesButton"
                    AutomationProperties.Name="从本机导入简历"
                    Click="ImportResumes_Click"
                    HorizontalAlignment="Right"
                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8E5;" />
                        <TextBlock Text="导入简历" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar
                x:Name="ImportError"
                Grid.Row="1"
                Closed="ImportError_Closed"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error"
                Title="部分简历导入失败" />

            <Grid Grid.Row="2">
                <GridView
                    x:Name="ResumeGrid"
                    AutomationProperties.AutomationId="ResumeGrid"
                    AutomationProperties.Name="候选人简历列表"
                    IsItemClickEnabled="True"
                    ItemsSource="{x:Bind ViewModel.Resumes, Mode=OneWay}"
                    SelectionMode="Single"
                    TabNavigation="Once"
                    Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.HasResumes), Mode=OneWay}">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid ItemHeight="430" ItemWidth="292" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,0,14,14" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:ResumeItem">
                            <Border
                                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneTime}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                ToolTipService.ToolTip="{x:Bind FilePath, Mode=OneTime}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="320" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        Padding="12">
                                        <Image
                                            AutomationProperties.Name="{x:Bind CandidateName, Mode=OneTime}"
                                            Source="{x:Bind Preview, Mode=OneTime}"
                                            Stretch="Uniform" />
                                    </Border>
                                    <Grid Grid.Row="1" Margin="14,12" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{x:Bind CandidateName, Mode=OneTime}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind DocumentInfo, Mode=OneTime}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind ImportedAtText, Mode=OneTime}" />
                                        </StackPanel>
                                        <Border
                                            Grid.Column="1"
                                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                            Padding="7,3"
                                            VerticalAlignment="Top">
                                            <TextBlock
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind TypeLabel, Mode=OneTime}" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <StackPanel
                    AutomationProperties.Name="尚未导入简历"
                    HorizontalAlignment="Center"
                    MaxWidth="440"
                    Spacing="12"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.IsEmpty), Mode=OneWay}">
                    <FontIcon
                        FontSize="48"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE8A5;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="从第一份候选人简历开始" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="可一次选择多份 PDF 或图片，系统会按列展示每份简历的首页预览。"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        AutomationProperties.AutomationId="EmptyStateImportButton"
                        AutomationProperties.Name="选择要导入的 PDF 或图片简历"
                        Click="ImportResumes_Click"
                        Content="选择文件"
                        HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel
                    AutomationProperties.LiveSetting="Polite"
                    HorizontalAlignment="Center"
                    Spacing="10"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.IsImporting), Mode=OneWay}">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsImporting, Mode=OneWay}" />
                    <TextBlock Text="正在生成简历预览，请稍候…" />
                </StackPanel>
            </Grid>
        </Grid>
    </NavigationView>
</Page>
